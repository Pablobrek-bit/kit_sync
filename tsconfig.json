{
  "compilerOptions": {
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "module": "commonjs",
    "target": "es2020",
    "strict": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "*": ["src/*"],
      "lib*": ["src/lib*"],
      "middleware/*": ["src/middleware/*"],
      "env": ["./src/env"]
    }
  },
  "include": ["src/**/*", "src/tests"],
  "exclude": ["node_modules"],
  "lib": ["es2015"],
  "typeRoots": ["node_modules/@types"],
  "types": ["node", "express"]
}
